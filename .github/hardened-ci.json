{
  "image": "varnish-hardened",
  "version": {"key": "varnish"},
  "revision": ["varnish", "Dockerfile", "init.go", "go.mod", "conf/", "scripts/", "versions.json"],
  "platforms": ["linux/amd64"],
  "compose_service": "varnish",
  "probes": [{"label": "Varnish", "want": "version", "cmd": "docker exec \"$(docker compose ps -q varnish)\" varnishd -V", "regex": "varnish-\\K[0-9][0-9.]*"}],
  "smoke": "./scripts/test.sh 127.0.0.1 8080"
}
